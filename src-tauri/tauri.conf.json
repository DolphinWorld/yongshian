{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Emergent Property (涌现 Yongshian)",
  "version": "0.1.0",
  "identifier": "com.yongshian.ai-council",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Emergent Property (涌现 Yongshian)",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
